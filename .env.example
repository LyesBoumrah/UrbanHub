# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais commité).

# --- OpenAQ (P3) : clé gratuite sur https://explore.openaq.org (paramètres du compte) ---
OPENAQ_API_KEY=

# --- MinIO (data lake) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=urbanhub
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=urbanhub

# --- ClickHouse (entrepôt) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=urbanhub
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=urbanhub

# --- Divers ---
HTTP_USER_AGENT=UrbanHub-school-project/0.1
LOG_LEVEL=INFO
