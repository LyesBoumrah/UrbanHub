# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais commité).

# --- OpenAQ (P3) : clé gratuite sur https://explore.openaq.org (paramètres du compte) ---
OPENAQ_API_KEY=

# --- Stockage du Data Lake : local (data/, pour tester) ou minio (machine finale) ---
STORAGE=local

# --- MinIO (data lake : 3 buckets dédiés bronze / silver / gold) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=urbanhub
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# --- Durée de récupération par défaut (ex. "1 semaine", "2 semaines", "1 mois", "5 ans") ---
FETCH_DURATION=1 semaine

# --- Divers ---
HTTP_USER_AGENT=UrbanHub-school-project/0.1
LOG_LEVEL=INFO
